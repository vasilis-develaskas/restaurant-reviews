# Copy this file to .env and fill in your own values.
# .env is ignored by Git and must never be committed.

# Secret key for signing JWTs: 32 random bytes, Base64-encoded.
# PowerShell: $bytes = New-Object byte[] 32; [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($bytes); [Convert]::ToBase64String($bytes)
JWT_SECRET=change-me